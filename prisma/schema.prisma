generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Professional {
  id                         String                 @id @default(uuid())
  fullname                   String?
  email                      String                 @unique
  password                   String
  profession                 JobCategory?
  idPassportUrl              String?
  bio                        String?
  isVerified                 Boolean                @default(false)
  otpCode                    String?
  otpExpiresAt               DateTime?
  passwordResetToken         String?
  passwordResetExpires       DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  cvUrl                      String?
  lastCoverLetter            String?
  firstName                  String?
  lastName                   String?
  middleName                 String?
  profilePhotoUrl            String?
  registrationStep           Int                    @default(1)
  subcategory                String?
  lastActive                 DateTime               @default(now())
  status                     ProfessionalStatus     @default(PENDING)
  tier                       UserTier               @default(FREE)
  availableForWork           Boolean                @default(false)
  publicProfileEnabled       Boolean                @default(false)
  membershipUpdatedAt        DateTime?
  /// Apple's stable per-subscription id (survives renewals). Set on first
  /// successful /membership/apple/confirm; lets the App Store Server
  /// Notifications webhook (which carries no auth/session) map an incoming
  /// renew/expire/refund/revoke event back to this professional.
  appleOriginalTransactionId String?                @unique
  suspendedAt                DateTime?
  suspendedUntil             DateTime?
  suspensionReason           String?
  suspendedById              String?
  statusBeforeSuspension     ProfessionalStatus?
  alerts                     Alert[]
  conversations              Conversation[]
  bookings                   CourseBooking[]
  applications               JobApplication[]
  invitations                JobInvitation[]
  documents                  ProfessionalDocument[]
  feedback                   ProfessionalFeedback[]
  kyc                        ProfessionalKyc?
  resume                     ProfessionalResume?
  savedCourses               SavedCourse[]
  savedJobs                  SavedJob[]
}

model ProfessionalFeedback {
  id             String       @id @default(uuid())
  professionalId String
  message        String
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("professional_feedback")
}

model Recruiter {
  id                                 String           @id @default(uuid())
  email                              String           @unique
  password                           String
  role                               RecruiterRole
  isVerified                         Boolean          @default(false)
  otpCode                            String?
  otpExpiresAt                       DateTime?
  passwordResetToken                 String?
  passwordResetExpires               DateTime?
  organizationName                   String?
  address                            String?
  website                            String?
  orgEmail                           String?
  idPassportUrl                      String?
  status                             RecruiterStatus  @default(PENDING)
  createdAt                          DateTime         @default(now())
  updatedAt                          DateTime         @updatedAt
  companyCity                        String?
  companyCountry                     String?
  companyLinkedIn                    String?
  companyState                       String?
  companyZip                         String?
  firstName                          String?
  lastName                           String?
  middleName                         String?
  otherRole                          String?
  personalRole                       String?
  phoneNumber                        String?
  phoneOtpCode                       String?
  phoneOtpExpiresAt                  DateTime?
  phoneVerified                      Boolean          @default(false)
  registrationStep                   Int              @default(1)
  agreedToTerms                      Boolean          @default(false)
  howDidYouHear                      String?
  isAuthorized                       Boolean          @default(false)
  phoneCode                          String?
  companyLogo                        String?
  lastActive                         DateTime         @default(now())
  tier                               RecruiterTier    @default(FREE)
  membershipUpdatedAt                DateTime?
  companyId                          String?
  stripeAccountId                    String?
  stripeOnboardingComplete           Boolean          @default(false)
  profilePhotoUrl                    String?
  organizationRiskLevel              KycRiskLevel?
  organizationVerificationData       Json?
  accountSettings                    Json?
  organizationVerificationDecision   String?
  organizationVerificationSelectedAt DateTime?
  organizationVerificationSource     String?
  organizationVerified               Boolean?
  suspendedAt                        DateTime?
  suspendedUntil                     DateTime?
  suspensionReason                   String?
  suspendedById                      String?
  statusBeforeSuspension             RecruiterStatus?
  company                            Company?         @relation(fields: [companyId], references: [id])
  companyMember                      CompanyMember?
  conversations                      Conversation[]
  courses                            Course[]
  jobs                               Job[]
  kyc                                RecruiterKyc?
}

model Company {
  id                  String                @id @default(uuid())
  name                String
  domain              String?               @unique
  type                RecruiterRole
  logoUrl             String?
  address             String?
  city                String?
  state               String?
  zip                 String?
  country             String?
  website             String?
  email               String?
  linkedIn            String?
  isClaimed           Boolean               @default(false)
  isVerified          Boolean               @default(false)
  tier                UserTier              @default(FREE)
  claimDate           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lastActive          DateTime              @default(now())
  recruiters          Recruiter[]
  members             CompanyMember[]
  mergeRequestsSource CompanyMergeRequest[] @relation("SourceCompany")
  mergeRequestsTarget CompanyMergeRequest[] @relation("TargetCompany")
  courses             Course[]
  jobs                Job[]

  @@map("companies")
}

model CompanyMember {
  id          String            @id @default(uuid())
  companyId   String
  recruiterId String            @unique
  role        CompanyMemberRole @default(RECRUITER)
  status      String            @default("ACTIVE")
  joinedAt    DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter   Recruiter         @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([companyId, recruiterId])
  @@map("company_members")
}

model CompanyMergeRequest {
  id              String             @id @default(uuid())
  sourceCompanyId String
  targetCompanyId String
  requestedById   String
  status          MergeRequestStatus @default(PENDING)
  reason          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sourceCompany   Company            @relation("SourceCompany", fields: [sourceCompanyId], references: [id])
  targetCompany   Company            @relation("TargetCompany", fields: [targetCompanyId], references: [id])

  @@map("company_merge_requests")
}

model ProfessionalResume {
  id                  String                           @id @default(uuid())
  professionalId      String                           @unique
  category            JobCategory?
  subcategory         String?
  address             String?
  city                String?
  state               String?
  postcode            String?
  country             String?
  phoneCode           String?
  phoneNumber         String?
  emailAddress        String?
  dateOfBirth         DateTime?
  summary             String?
  gender              String?
  height              Float?
  weight              Float?
  bmi                 Float?
  eyeColor            String?
  overallSize         String?
  shoeSize            String?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  education           ProfessionalEducation[]
  licenses            ProfessionalLicense[]
  medicalCertificates ProfessionalMedicalCertificate[]
  nextOfKin           ProfessionalNextOfKin[]
  referees            ProfessionalReferee[]
  professional        Professional                     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  seaService          ProfessionalSeaServiceLog[]
  skills              ProfessionalSkill[]
  stcwCertificates    ProfessionalSTCWCertificate[]
  travelDocuments     ProfessionalTravelDocument[]

  @@map("professional_resumes")
}

model ProfessionalSkill {
  id        String             @id @default(uuid())
  resumeId  String
  skillName String
  rating    Int?               @default(0)
  resume    ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_skills")
}

model ProfessionalLicense {
  id            String             @id @default(uuid())
  resumeId      String
  name          String
  number        String?
  country       String?
  issueDate     DateTime?
  expiryDate    DateTime?
  isEndorsement Boolean?           @default(false)
  isCertificate Boolean?           @default(false)
  resume        ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_licenses")
}

model ProfessionalSeaServiceLog {
  id          String             @id @default(uuid())
  resumeId    String
  companyName String
  role        String?
  vesselName  String?
  imoNumber   String?
  flag        String?
  vesselType  String?
  dwt         String?
  meType      String?
  kwtType     String?
  joiningDate DateTime?
  tillDate    DateTime?
  resume      ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_sea_service_logs")
}

model ProfessionalEducation {
  id                String             @id @default(uuid())
  resumeId          String
  qualificationName String
  institution       String?
  grade             String?
  startDate         DateTime?
  endDate           DateTime?
  city              String?
  country           String?
  resume            ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_educations")
}

model ProfessionalSTCWCertificate {
  id                String             @id @default(uuid())
  resumeId          String
  qualification     String
  certificateNumber String?
  issuingCountry    String?
  issueDate         DateTime?
  expiryDate        DateTime?
  resume            ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_stcw_certs")
}

model ProfessionalMedicalCertificate {
  id                 String             @id @default(uuid())
  resumeId           String
  name               String
  certificateNumber  String?
  issuingCountry     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  city               String?
  documentNumber     String?
  institutionCountry String?
  resume             ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_medical_certs")
}

model ProfessionalTravelDocument {
  id                 String             @id @default(uuid())
  resumeId           String
  name               String
  documentNumber     String?
  issuingCountry     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  city               String?
  institutionCountry String?
  resume             ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_travel_docs")
}

model ProfessionalNextOfKin {
  id           String             @id @default(uuid())
  resumeId     String
  name         String
  relationship String?
  countryCode  String?
  phoneNumber  String?
  email        String?
  resume       ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_next_of_kin")
}

model ProfessionalReferee {
  id          String             @id @default(uuid())
  resumeId    String
  name        String
  position    String?
  countryCode String?
  phoneNumber String?
  email       String?
  companyName String?
  resume      ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("professional_referees")
}

model Admin {
  id                   String         @id @default(uuid())
  email                String         @unique
  password             String
  role                 AdminRole      @default(SUPER_ADMIN)
  accountSettings      Json?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  caseNotes            CaseNote[]
  conversations        Conversation[]
  courses              Course[]
  jobs                 Job[]
  kycNotes             KycNote[]
  assignedCases        SupportCase[]  @relation("AssignedCases")
  reviewedReports      UserReport[]   @relation("ReviewedReports")
  reportNotes          ReportNote[]

  @@map("admins")
}

/// A member-to-member abuse report. Kept separate from SupportCase: a support case is
/// a help request, a report is a moderation signal against a specific account.
model UserReport {
  id             String       @id @default(uuid())
  reference      String       @unique
  reporterId     String
  reporterType   ActorType
  reporterEmail  String?
  reporterName   String?
  reportedId     String
  reportedType   ActorType
  reportedEmail  String?
  reportedName   String?
  reason         ReportReason
  details        String
  conversationId String?
  status         ReportStatus @default(PENDING)
  actionTaken    ReportAction @default(NONE)
  resolutionNote String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reviewedBy     Admin?       @relation("ReviewedReports", fields: [reviewedById], references: [id])
  notes          ReportNote[]

  @@index([status])
  @@index([reportedId])
  @@index([reporterId])
  @@index([createdAt])
  @@map("user_reports")
}

/// Internal admin-only notes on a report. Multiple admins can leave notes while a
/// report is still open; the author's email is denormalised so the audit trail
/// survives even if the admin account is later removed.
model ReportNote {
  id         String     @id @default(uuid())
  reportId   String
  adminId    String?
  adminEmail String?
  content    String
  createdAt  DateTime   @default(now())
  admin      Admin?     @relation(fields: [adminId], references: [id])
  report     UserReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([createdAt])
  @@map("report_notes")
}

model Job {
  id                      String           @id @default(uuid())
  title                   String
  location                String
  category                JobCategory
  contractType            JobType
  salary                  String
  description             String
  recruiterId             String?
  adminId                 String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  isFlagged               Boolean          @default(false)
  status                  JobStatus        @default(ACTIVE)
  companyId               String?
  riskLevel               KycRiskLevel     @default(LOW)
  closingDate             DateTime?
  isPremiumListing        Boolean          @default(false)
  premiumListingExpiresAt DateTime?
  applications            JobApplication[]
  invitations             JobInvitation[]
  admin                   Admin?           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  company                 Company?         @relation(fields: [companyId], references: [id])
  recruiter               Recruiter?       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  savedBy                 SavedJob[]

  @@map("jobs")
}

/// One row per externally-sourced job (SerpApi Google Jobs + syndicated
/// maritime feeds). Populated once a day by a scheduled refresh job, not by
/// user requests — the "External Jobs" tab reads and ranks this table.
/// `id` is the source-prefixed id (e.g. "serpapi:...", "feed:...") so a
/// re-fetch naturally upserts instead of duplicating.
model ExternalJobListing {
  id              String    @id
  title           String
  company         String?
  location        String?
  description     String
  salary          String?
  postedAt        String?
  applyLink       String?
  via             String?
  thumbnail       String?
  category        String?
  employmentType  String?
  provider        String
  /// Start time of the refresh run that last saw this listing.
  /// Feed-sourced rows are deleted once no longer returned by that day's full
  /// re-fetch. SerpApi/JSearch rows are NOT deleted on this basis — each is
  /// only re-confirmed when its query's turn in the daily rotation comes back
  /// around (see externalJobs/queryGrid.ts), so an old fetchedAt just means
  /// "not re-checked recently", not "gone from the market". Those age out of
  /// view primarily through ranking (getExternalJobsForProfessional always
  /// sorts newest-first) and are only actually deleted once `createdAt`
  /// (below) crosses refresh.ts's fixed LISTING_RETENTION_DAYS (35 days) —
  /// a backstop against unbounded growth, deliberately not keyed off this
  /// field. The other way one leaves the platform is admin moderation via
  /// hiddenByAdmin below, which is immediate regardless of age.
  fetchedAt       DateTime
  /// When this listing was first discovered. Never touched by refresh.ts's
  /// upsert `update` payload (only `create` sets it), so it stays fixed at
  /// first-seen time for as long as the row exists — this, not `fetchedAt`,
  /// is what the 35-day retention window above is measured against.
  createdAt       DateTime  @default(now())
  /// Admin review/removal — set when an admin judges a scraped listing bad,
  /// suspicious, or a scam. Deliberately NOT included in refresh.ts's upsert
  /// `update` payload, so a daily re-fetch of the same source id (the API/AI
  /// re-listing something an admin already rejected) can never silently
  /// resurrect it. Excluded from the professional-facing pool and from the
  /// admin's own "Scraped Listings" view once set — this is what "delete"
  /// means from both of their perspectives, even though the row survives for
  /// audit purposes rather than being hard-deleted.
  hiddenByAdmin   Boolean   @default(false)
  hiddenAt        DateTime?
  hiddenByAdminId String?
  updatedAt       DateTime  @updatedAt

  @@index([fetchedAt])
  @@index([hiddenByAdmin])
  @@map("external_job_listings")
}

model JobApplication {
  id                String                 @id @default(uuid())
  jobId             String
  professionalId    String
  status            ApplicationStatus      @default(APPLIED)
  rejectionReason   String?
  coverLetter       String?
  resumeSnapshot    Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  cvUrl             String?
  coverLetterUrl    String?
  job               Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  professional      Professional           @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  attachedDocuments ProfessionalDocument[] @relation("ApplicationDocuments")

  @@unique([jobId, professionalId])
  @@index([status])
  @@map("job_applications")
}

model SavedJob {
  id             String       @id @default(uuid())
  professionalId String
  jobId          String
  createdAt      DateTime     @default(now())
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, jobId])
  @@map("saved_jobs")
}

model Course {
  id                    String          @id @default(uuid())
  title                 String
  location              String?
  category              String
  contractType          String?
  description           String
  recruiterId           String?
  adminId               String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  currency              String          @default("GBP")
  price                 Decimal         @db.Decimal(10, 2)
  stripePriceId         String?
  stripeProductId       String?
  capacity              Int?
  certificationProvided String?
  courseType            CourseType      @default(INTERNAL)
  curriculum            String?
  enrolledCount         Int             @default(0)
  externalUrl           String?
  flagReason            String?
  isFlagged             Boolean         @default(false)
  requirements          String?
  status                CourseStatus    @default(ACTIVE)
  duration              String?
  issuingAuthority      String?
  trainingType          String?
  companyId             String?
  riskLevel             KycRiskLevel    @default(LOW)
  bookings              CourseBooking[]
  sessions              CourseSession[]
  admin                 Admin?          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  company               Company?        @relation(fields: [companyId], references: [id])
  recruiter             Recruiter?      @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  savedBy               SavedCourse[]

  @@map("courses")
}

model CourseSession {
  id                 String          @id @default(uuid())
  courseId           String
  startDate          DateTime
  endDate            DateTime
  startTime          String?
  endTime            String?
  location           String
  instructor         String?
  totalSeats         Int
  availableSeats     Int
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  enrollmentDeadline DateTime?
  course             Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings           CourseBooking[] @relation("BookingSessions")

  @@map("course_sessions")
}

model CourseBooking {
  id                    String                 @id @default(uuid())
  professionalId        String
  courseId              String
  bookingStatus         BookingStatus          @default(PENDING)
  paymentStatus         PaymentStatus          @default(PENDING)
  stripePaymentIntentId String?                @unique
  stripeSessionId       String?                @unique
  amountPaid            Decimal                @db.Decimal(10, 2)
  currency              String                 @default("GBP")
  bookedAt              DateTime               @default(now())
  paidAt                DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  platformFee           Decimal?               @db.Decimal(10, 2)
  trainerPayout         Decimal?               @db.Decimal(10, 2)
  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professional          Professional           @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  attachedDocuments     ProfessionalDocument[] @relation("BookingDocuments")
  sessions              CourseSession[]        @relation("BookingSessions")

  @@map("course_bookings")
}

model SavedCourse {
  id             String       @id @default(uuid())
  professionalId String
  courseId       String
  createdAt      DateTime     @default(now())
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, courseId])
  @@map("saved_courses")
}

model Conversation {
  id             String        @id @default(uuid())
  professionalId String?
  recruiterId    String?
  adminId        String?
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  recruiter      Recruiter?    @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  admin          Admin?        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([professionalId, recruiterId])
  @@unique([professionalId, adminId])
  @@unique([recruiterId, adminId])
  @@index([professionalId])
  @@index([recruiterId])
  @@index([adminId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderType     MessageSender
  senderId       String
  content        String
  isRead         Boolean       @default(false)
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([isRead])
  @@map("messages")
}

model RecruiterKyc {
  id               String          @id @default(uuid())
  recruiterId      String          @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  documentType     KYCDocumentType
  documentNumber   String
  expiryDate       DateTime
  issueCountry     String
  documentUrl      String?
  selfieUrl        String?
  status           RecruiterStatus @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  mismatchDetails  String?
  mismatchDetected Boolean         @default(false)
  ocrConfidence    Float?
  reviewStep       Int             @default(3)
  riskLevel        KycRiskLevel    @default(LOW)
  documentBackUrl  String?
  documentFrontUrl String?
  notes            KycNote[]
  recruiter        Recruiter       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("recruiter_kyc")
}

model ProfessionalKyc {
  id               String          @id @default(uuid())
  professionalId   String          @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  documentType     KYCDocumentType
  documentNumber   String
  expiryDate       DateTime
  issueCountry     String
  selfieUrl        String?
  status           RecruiterStatus @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  mismatchDetails  String?
  mismatchDetected Boolean         @default(false)
  ocrConfidence    Float?
  reviewStep       Int             @default(3)
  riskLevel        KycRiskLevel    @default(LOW)
  documentBackUrl  String?
  documentFrontUrl String?
  notes            KycNote[]
  professional     Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("professional_kyc")
}

model KycNote {
  id                String           @id @default(uuid())
  content           String
  adminId           String
  professionalKycId String?
  recruiterKycId    String?
  createdAt         DateTime         @default(now())
  admin             Admin            @relation(fields: [adminId], references: [id])
  professionalKyc   ProfessionalKyc? @relation(fields: [professionalKycId], references: [id], onDelete: Cascade)
  recruiterKyc      RecruiterKyc?    @relation(fields: [recruiterKycId], references: [id], onDelete: Cascade)

  @@map("kyc_notes")
}

model ProfessionalDocument {
  id                      String             @id @default(uuid())
  professionalId          String
  category                DocumentCategory
  name                    String
  number                  String?
  issuingCountry          String?
  issueDate               DateTime?
  expiryDate              DateTime?
  fileUrl                 String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  mimeType                String?
  ocrData                 Json?
  ocrStatus               OCRStatus          @default(PENDING)
  verificationStatus      VerificationStatus @default(PENDING)
  /// Last expiry-reminder milestone emailed for this document ("90" | "60" | "30" | "7" | "EXPIRED").
  /// Kept so the daily reminder job sends once per milestone instead of every day.
  lastExpiryReminderStage String?
  lastExpiryReminderAt    DateTime?
  professional            Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  jobApplications         JobApplication[]   @relation("ApplicationDocuments")
  courseBookings          CourseBooking[]    @relation("BookingDocuments")

  @@index([expiryDate])
  @@map("professional_documents")
}

model ActivityLog {
  id         String       @id @default(uuid())
  action     String
  actorId    String
  actorType  ActorType
  targetId   String?
  targetType String?
  ipAddress  String?
  userAgent  String?
  status     ActionStatus
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("activity_logs")
}

model SupportCase {
  id           String       @id @default(uuid())
  caseId       String       @unique
  subject      String
  description  String
  priority     CasePriority @default(MEDIUM)
  status       CaseStatus   @default(OPEN)
  category     String
  userId       String?
  userType     ActorType?
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  notes        CaseNote[]
  assignedTo   Admin?       @relation("AssignedCases", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([userId])
  @@map("support_cases")
}

model CaseNote {
  id          String      @id @default(uuid())
  caseId      String
  adminId     String?
  content     String
  isInternal  Boolean     @default(true)
  createdAt   DateTime    @default(now())
  authorId    String?
  admin       Admin?      @relation(fields: [adminId], references: [id])
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_notes")
}

model Alert {
  id             String       @id @default(uuid())
  professionalId String
  type           String
  title          String
  message        String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([isRead])
  @@index([createdAt])
  @@map("alerts")
}

model JobInvitation {
  id             String           @id @default(uuid())
  jobId          String
  professionalId String
  recruiterId    String
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([jobId, professionalId])
  @@map("job_invitations")
}

