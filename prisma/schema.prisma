// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Professional {
  id            String    @id @default(uuid())
  fullname      String
  email         String    @unique
  password      String
  profession    String?
  idPassportUrl String?
  bio           String?
  isVerified    Boolean   @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  
  passwordResetToken   String?
  passwordResetExpires DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum RecruiterRole {
  RECRUITMENT_AGENT
  TRAINING_AGENT
}

enum RecruiterStatus {
  PENDING
  APPROVED
  REJECTED
}

model Recruiter {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  role             RecruiterRole
  isVerified      Boolean         @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Organizational Details (Step 4)
  organizationName String?
  address          String?
  website          String?
  orgEmail         String?
  idPassportUrl    String?
  
  status           RecruiterStatus @default(PENDING)
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}


