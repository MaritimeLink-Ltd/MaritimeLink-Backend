// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Professional {
  id            String    @id @default(uuid())
  fullname      String
  email         String    @unique
  password      String
  profession    JobCategory?
  idPassportUrl String?
  bio           String?
  isVerified    Boolean   @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  
  passwordResetToken   String?
  passwordResetExpires DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resume        ProfessionalResume?
  savedJobs     SavedJob[]
  conversations Conversation[]
}

enum JobCategory {
  OFFICER
  RATINGS_AND_CREW
  CATERING_AND_MEDICAL
}

enum JobType {
  TEMPORARY
  CONTRACT
  PERMANENT
}

enum RecruiterRole {
  RECRUITMENT_AGENT
  TRAINING_AGENT
}

enum RecruiterStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KYCDocumentType {
  PASSPORT
  DRIVING_LICENSE
  NATIONAL_ID
  RESIDENCE_PERMIT
}

model Recruiter {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  role             RecruiterRole
  isVerified      Boolean         @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Organizational Details (Step 4)
  organizationName String?
  address          String?
  website          String?
  orgEmail         String?
  idPassportUrl    String?
  
  status           RecruiterStatus @default(PENDING)
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  kyc              RecruiterKyc?
  jobs             Job[]
  courses          Course[]
  conversations    Conversation[]
}

enum MessageSender {
  PROFESSIONAL
  RECRUITER
}
model ProfessionalResume {
  id                  String   @id @default(uuid())
  professionalId      String   @unique
  professional        Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  // Category info
  category            JobCategory?
  subcategory         String?

  // Personal Info
  address             String?
  city                String?
  state               String?
  postcode            String?
  country             String?
  phoneCode           String?
  phoneNumber         String?
  emailAddress        String?
  dateOfBirth        DateTime?

  // Professional Summary
  summary             String?  @db.Text

  // Biometrics
  gender              String?
  height              Float?
  weight              Float?
  bmi                 Float?
  eyeColor            String?
  overallSize         String?
  shoeSize            String?

  // Relations
  skills              ProfessionalSkill[]
  licenses            ProfessionalLicense[]
  seaService          ProfessionalSeaServiceLog[]
  education           ProfessionalEducation[]
  stcwCertificates    ProfessionalSTCWCertificate[]
  medicalCertificates ProfessionalMedicalCertificate[]
  travelDocuments     ProfessionalTravelDocument[]
  nextOfKin           ProfessionalNextOfKin[]
  referees            ProfessionalReferee[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("professional_resumes")
}

model ProfessionalSkill {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skillName        String
  rating           Int?               @default(0)

  @@map("professional_skills")
}

model ProfessionalLicense {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name             String
  number           String?
  country          String?
  issueDate        DateTime?
  expiryDate       DateTime?

  @@map("professional_licenses")
}

model ProfessionalSeaServiceLog {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  companyName      String
  role             String?
  vesselName       String?
  imoNumber        String?
  flag             String?
  vesselType       String?
  dwt              String?
  meType           String?
  kwtType          String?
  joiningDate      DateTime?
  tillDate         DateTime?

  @@map("professional_sea_service_logs")
}

model ProfessionalEducation {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  qualificationName String
  institution      String?
  grade            String?
  startDate        DateTime?
  endDate          DateTime?

  @@map("professional_educations")
}

model ProfessionalSTCWCertificate {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  qualification    String
  certificateNumber String?
  issuingCountry   String?
  issueDate        DateTime?
  expiryDate       DateTime?

  @@map("professional_stcw_certs")
}

model ProfessionalMedicalCertificate {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name             String
  certificateNumber String?
  issuingCountry   String?
  issueDate        DateTime?
  expiryDate       DateTime?

  @@map("professional_medical_certs")
}

model ProfessionalTravelDocument {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name             String
  documentNumber   String?
  issuingCountry   String?
  issueDate        DateTime?
  expiryDate       DateTime?

  @@map("professional_travel_docs")
}

model ProfessionalNextOfKin {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name             String
  relationship     String?
  countryCode      String?
  phoneNumber      String?
  email            String?

  @@map("professional_next_of_kin")
}

model ProfessionalReferee {
  id               String             @id @default(uuid())
  resumeId         String
  resume           ProfessionalResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name             String
  position         String?
  countryCode      String?
  phoneNumber      String?
  email            String?

  @@map("professional_referees")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

model Admin {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String
  role             AdminRole   @default(SUPER_ADMIN)
  
  passwordResetToken   String?
  passwordResetExpires DateTime?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  jobs             Job[]
  courses          Course[]

   @@map("admins")
}

model Job {
  id           String      @id @default(uuid())
  title        String
  location     String
  category     JobCategory
  contractType JobType
  salary       String
  description  String      @db.Text
  
  recruiterId  String?
  recruiter    Recruiter?  @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  
  adminId      String?
  admin        Admin?      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  savedBy      SavedJob[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("jobs")
}

model SavedJob {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([professionalId, jobId])
  @@map("saved_jobs")
}

model Course {
  id           String      @id @default(uuid())
  title        String
  location     String
  category     String
  contractType String
  description  String      @db.Text
  
  recruiterId  String?
  recruiter    Recruiter?  @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  
  adminId      String?
  admin        Admin?      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("courses")
}

model Conversation {
  id                String   @id @default(uuid())
  professionalId    String
  professional      Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  recruiterId       String
  recruiter         Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  
  lastMessageAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  messages          Message[]
  
  @@unique([professionalId, recruiterId])
  @@index([professionalId])
  @@index([recruiterId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderType      MessageSender
  senderId        String
  content         String        @db.Text
  
  isRead          Boolean       @default(false)
  readAt          DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([conversationId, createdAt])
  @@index([isRead])
  @@map("messages")
}

model RecruiterKyc {
  id               String          @id @default(uuid())
  recruiterId      String          @unique
  recruiter        Recruiter       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  documentType     KYCDocumentType
  documentNumber   String
  expiryDate       DateTime
  issueCountry     String
  documentUrl      String
  selfieUrl        String?
  
  status           RecruiterStatus @default(PENDING)
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("recruiter_kyc")
}
