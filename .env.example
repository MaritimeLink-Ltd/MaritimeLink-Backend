NODE_ENV=development
PORT=3000

# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET=your_jwt_secret_here

# SMTP (Email Service)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# Supabase Storage & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_NAME=professional-ids
SUPABASE_RECRUITER_BUCKET_NAME=recruiter-ids
SUPABASE_RECRUITER_KYC_DOCS_BUCKET=recruiter-kyc-docs
SUPABASE_RECRUITER_KYC_SELFIES_BUCKET=recruiter-kyc-selfies
SUPABASE_PROFESSIONAL_KYC_DOCS_BUCKET=professional-kyc-docs
SUPABASE_PROFESSIONAL_KYC_SELFIES_BUCKET=professional-kyc-selfies

# Frontend
FRONTEND_URL=http://localhost:5173

SUPABASE_RECRUITER_KYC_DOCS_BUCKET=recruiter-kyc-docs
SUPABASE_RECRUITER_KYC_SELFIES_BUCKET=recruiter-kyc-selfies
# Documents Wallet Buckets
SUPABASE_DOCUMENT_WALLET_BUCKET=document-wallet

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: membership plans are loaded from Stripe Product catalog (recurring prices).
# Env price IDs are no longer required; create products in Stripe Dashboard instead.

# Recruiter plans (required). Must match the pricing document:
#   Flex Recruiter    — one-time, GBP 99.90, per job listing (30 days)
#   Premium Recruiter — recurring monthly, GBP 199.90
# Keep these in step with RECRUITER_PLANS in recruiterMembershipController.ts,
# which is what the subscription cards display.
STRIPE_RECRUITER_FLEX_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_RECRUITER_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# External job aggregation (the professional "External Jobs" tab).
# Listings are refreshed at most once every 24h and always link off-platform.
#
# Both metered providers below pool multiple keys: quota is metered per key,
# not per account, so each key you add widens the daily search budget in
# proportion (3 SerpApi keys = 750 searches/month, not 250). Keys are used
# round-robin, and one that reports itself out is retired for the rest of that
# run while the others carry on. Numbered slots are optional and gaps are fine.
#
# Source 1 — SerpApi Google Jobs. Skipped entirely if no key is set.
SERPAPI_KEY=your_serpapi_key_here
# SERPAPI_KEY_2=your_second_serpapi_key_here
# SERPAPI_KEY_3=your_third_serpapi_key_here
#
# Ceiling on SerpApi searches per daily refresh, across all keys combined.
# Leave this unset: the budget already works out to 8/day per configured key
# (8 x 31 days = 248, inside a 250-searches/month free key), and actual usage
# is additionally clamped per key to whatever that account has left this month
# — so the refresh degrades to feed-only instead of erroring once quota runs
# out. Only set this to deliberately hold usage *below* what the keys allow.
# SERPAPI_MAX_QUERIES_PER_DAY=24
#
# Source 2 — JSearch (RapidAPI), a second live job aggregator (Indeed,
# LinkedIn, Glassdoor, Google Jobs...), independent quota pool from SerpApi.
# Skipped entirely if no key is set. Each key must come from a separate
# RapidAPI app — the same key pasted into two slots is one quota, not two
# (duplicates are detected and collapsed rather than double-counted).
JSEARCH_API_KEY=your_rapidapi_jsearch_key_here
# JSEARCH_API_KEY_2=your_second_rapidapi_jsearch_key_here
# JSEARCH_API_KEY_3=your_third_rapidapi_jsearch_key_here
#
# Ceiling on JSearch searches per daily refresh, across all keys combined.
# Same advice: leave unset. Defaults to 6/day per configured key (6 x 31 = 186,
# inside a 200-searches/month free key). JSearch has no free quota-check
# endpoint (unlike SerpApi), so that budget is the only pre-flight signal —
# each key's real remaining balance is read from the
# x-ratelimit-requests-remaining response header as the run goes and used to
# correct that key's budget downward mid-run.
# JSEARCH_MAX_QUERIES_PER_DAY=18
#
# Source 3 — syndicated maritime job-board RSS/Atom feeds, read in-house.
# No default feeds are configured — leave unset unless you have a feed that's
# genuinely scoped to the target regions (Europe/Africa/Asia) and from a
# verified company/board; a global/unscoped feed reintroduces out-of-region
# jobs the same way the previous defaults did. Comma-separated feed URLs.
# Requests honour robots.txt and are rate-limited per host.
# EXTERNAL_JOB_FEEDS=

# Apple In-App Purchase (iOS app subscription — no effect on the website,
# which stays on Stripe via STRIPE_* above). Verifies the StoreKit 2 signed
# transaction the app submits directly against Apple's certificate chain
# (src/config/certs/AppleRootCA-G3.cer, a public file downloaded from
# apple.com/certificateauthority) — no separate App Store Server API
# private key/Key ID/Issuer ID needed for this. Without APPLE_BUNDLE_ID set,
# /membership/apple/confirm and the /webhooks/apple endpoint both reject
# every request rather than silently no-op.
APPLE_BUNDLE_ID=com.maritime.maritimelink
# Must match the subscription's product id in App Store Connect exactly.
APPLE_IAP_PRODUCT_ID=monthly
# The app's own Apple ID from App Store Connect > App Information — NOT the
# in-app-purchase product's id. Required by Apple's verifier for real
# (Production) purchases; Sandbox/TestFlight testing works without it.
# APPLE_APP_APPLE_ID=

# Twilio (phone OTP during recruiter / training agent signup)
# Phone OTP runs on Twilio Verify: Twilio generates, sends and checks the code,
# so no purchased Twilio number is required. Create a Verify service in the
# Twilio console (Verify > Services) and paste its VA... SID below.
# Without ACCOUNT_SID + AUTH_TOKEN + VERIFY_SERVICE_SID the OTP falls back to a
# locally generated code that is logged to the console and emailed.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only used by plain sendSMS() calls, not by phone OTP.
TWILIO_PHONE_NUMBER=+15551234567
